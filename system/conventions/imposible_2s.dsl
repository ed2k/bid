# Option: Imposible 2S
# Description: Artificial 2S rebid in specific auctions (e.g. 1m-1H-1NT-2S) showing GF checkback/minor fit without 4 spades.

# Impossible 2S (GF Minor fit / checkback without 4 spades)
1D - 1H - 1NT - 2S:
  CONVENTION: Impossible_2S
  FORCING: GAME_FORCING
  HCP: 12+
  LEN S: 0-3
  LEN D: 4+
