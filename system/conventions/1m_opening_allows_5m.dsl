# Option: 1m opening allows 5M
# Description: Permits opening 1C/1D with a 5-card major under specific system rules (e.g. 5-3-3-2).

# 1m Opening Allows 5-Card Major (e.g. 5332)
OPEN 1C:
  CONVENTION: 1m_Allows_5M
  HCP: 12-21
  LEN C: 3+

OPEN 1D:
  CONVENTION: 1m_Allows_5M
  HCP: 12-21
  LEN D: 3+
