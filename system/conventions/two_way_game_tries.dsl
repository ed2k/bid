# Two-Way Game Tries (Step = Short-suit try, others = Long-suit try)
1H - 2H - 2S:
  CONVENTION: Short_Suit_Game_Try
  HCP: 14-16
  LEN H: 5+

1H - 2H - 3C:
  CONVENTION: Long_Suit_Game_Try
  HCP: 14-16
  LEN H: 5+
  LEN C: 4+

1S - 2S - 2NT:
  CONVENTION: Short_Suit_Game_Try
  HCP: 14-16
  LEN S: 5+

1S - 2S - 3C:
  CONVENTION: Long_Suit_Game_Try
  HCP: 14-16
  LEN S: 5+
  LEN C: 4+
