# Option: 1N-2N transfer to clubs
# Description: 2NT response over 1NT transfers to 3C.

# Minor Suit Transfers after 1NT (2NT->3C, 3C->3D)
1NT - 2NT:
  CONVENTION: Transfer_To_Clubs
  LEN C: 6+
  TP: 8+

1NT - 2NT - 3C:
  CONVENTION: Accept_Transfer_Clubs
  LEN C: 2+

1NT - 3C:
  CONVENTION: Transfer_To_Diamonds
  LEN D: 6+
  TP: 8+

1NT - 3C - 3D:
  CONVENTION: Accept_Transfer_Diamonds
  LEN D: 2+
