# Minor Transfers after 2NT (3S->Clubs, 4C->Diamonds)
2NT - 3S:
  CONVENTION: 2NT_Transfer_To_Clubs
  LEN C: 6+
  TP: 5+

2NT - 4C:
  CONVENTION: 2NT_Transfer_To_Diamonds
  LEN D: 6+
  TP: 5+

2NT - 3S - 4C:
  CONVENTION: 2NT_Accept_Clubs
  LEN C: 2+

2NT - 4C - 4D:
  CONVENTION: 2NT_Accept_Diamonds
  LEN D: 2+
