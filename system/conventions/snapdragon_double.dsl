# Option: Snapdragon Double
# Description: Double of 4th suit in competitive auction showing 5+ cards in 4th suit and tolerance for partner's suit.

# Responsive Double & Snapdragon Double
(1D) - Dbl - (2D) - Dbl:
  CONVENTION: Responsive_Double
  HCP: 8+
  LEN H: 4+
  LEN S: 4+

1C - (1D) - 1H - (1S) - Dbl:
  CONVENTION: Snapdragon_Double
  HCP: 8+
  LEN S: 5+
